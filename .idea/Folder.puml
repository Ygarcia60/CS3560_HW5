@startuml
'https://plantuml.com/class-diagram
title Part 5 Folder composition
class Folder {
 - name: String
 - subfolders: List<Folder>
 - files: List<File>
 + getName(): String
 + setName(name: String): void
 + addFolder(folder: Folder): void
 + removeFolder(folder: Folder): void
 + addFile(file: File): void
 + removeFile(file: File): void
 + print(): void
}
class File {
 - name: String
 + getName(): String
 + setName(name: String): void
 + print(): void
}
Folder "1" *-- "0..*" Folder : subfolders
Folder "1" *-- "0..*" File : files
@enduml